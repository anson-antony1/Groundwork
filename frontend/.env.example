# Groundwork frontend settings. Copy to .env.local (git-ignored) and edit.
# Nothing here is secret: VITE_ variables are bundled into the page, so never put tokens or API keys in them.

# Data source. "mock" = in-browser demo fixture (no backend needed); "live" = the FastAPI backend.
VITE_API_MODE=mock

# Leave empty to call the API on the same origin; the dev server proxies /api and /uploads to API_PROXY_TARGET.
# Only set this (e.g. http://localhost:8000) if you skip the proxy. A phone on the LAN can't reach localhost.
VITE_API_BASE_URL=

# Where the dev server forwards /api and /uploads. Read by vite.config.ts only; never sent to the browser.
API_PROXY_TARGET=http://localhost:8000

# Public builds only (set by render.yaml / the Dockerfile; leave unset locally).
# VITE_HOSTED=1 marks the shared live server (e.g. "replay is shared" note).
# VITE_TRY_DOCK=1 shows a visible launcher for the rehearsal controls on the mock-mode demo site.
# VITE_HOSTED=
# VITE_TRY_DOCK=
# Public URLs, so /welcome on each deployment links to the other and the social card gets an absolute URL.
# VITE_LIVE_URL=https://groundwork.onrender.com
# VITE_DEMO_URL=https://groundwork-demo.onrender.com
# VITE_PUBLIC_URL=

# Auth0 login (live mode only). Public values of the "Groundwork Web" single-page app; leave unset for no login.
# The audience and roles claim must match the backend's AUTH0_AUDIENCE / AUTH0_ROLES_CLAIM exactly.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=
# VITE_AUTH0_AUDIENCE=https://groundwork-api
# VITE_AUTH0_ROLES_CLAIM=https://groundwork-api/roles
