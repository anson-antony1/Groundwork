# Groundwork frontend settings. Copy to .env.local (git-ignored) and edit.
# Nothing here is secret: VITE_ variables are bundled into the page, so never put tokens or API keys in them.

# Data source. "mock" = in-browser demo fixture (no backend needed); "live" = the FastAPI backend.
VITE_API_MODE=mock

# Leave empty to call the API on the same origin; the dev server proxies /api and /uploads to API_PROXY_TARGET.
# Only set this (e.g. http://localhost:8000) if you skip the proxy. A phone on the LAN can't reach localhost.
VITE_API_BASE_URL=

# Where the dev server forwards /api and /uploads. Read by vite.config.ts only; never sent to the browser.
API_PROXY_TARGET=http://localhost:8000
