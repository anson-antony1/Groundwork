# Shared secret the serial bridge sends as "Authorization: Bearer <token>".
# Defaults to dev-sensor-token if unset.
GROUNDWORK_SENSOR_TOKEN=change-me

# --- Auth0 (backend) ---
# Off by default: every caller is a labeled demo user with crew + supervisor roles.
# Turn on once the Auth0 tenant, API and Post-Login roles Action exist; turn off again if the venue network fails.
GROUNDWORK_AUTH_ENABLED=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://groundwork-api
AUTH0_ROLES_CLAIM=https://groundwork-api/roles
# Keep accepting the static sensor token above with Auth0 on (offline bridge fallback). Set false to require M2M tokens.
GROUNDWORK_ALLOW_STATIC_SENSOR_TOKEN=true
